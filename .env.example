# Application
NODE_ENV=development
PORT=3000

# Database (matches docker-compose.yml)
POSTGRES_USER=bulir
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bulir
# Host port published by docker-compose (change it if 5432 is already taken)
DB_PORT=5432
DATABASE_URL=postgresql://bulir:change-me@localhost:5432/bulir?schema=public

# Auth: use a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h

# Rate limiting: max requests per window per IP
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60
# Tests only: disables rate limiting so e2e suites can create many users. NEVER set in production.
# THROTTLE_DISABLED=true

# Docker
# Host port for the API container (docker compose --profile app up)
API_PORT=3000
# Allowed browser origins, comma separated (required in production). Empty = allow any (development only).
CORS_ORIGIN=
